{# ─── NAYZEEE · module.cursor.twig · Custom cursor: the feather arrow, and the Deku character over links and buttons, both recoloured to the accent.
   Included by layout.html, username.html and options.html. Only applies to mouse devices.
   Settings: cursor-toggle (On/Off), cursor-url / cursor-pointer-url to swap in your own PNG (32x32 max, hotspot top-left). ─── #}
{% if (config('cursor-toggle') ?: 'On') != 'Off' %}
<style>
@media (hover:hover) and (pointer:fine){
  html,body,body *{cursor:url({{ config('cursor-url') ?: 'data:image/png;base64,' }}) 1 0,auto!important}
  a,button,[role=button],summary,label,select,.pk,.bi,.sr,.segc button,.segc a,[data-open],[data-add],[data-remove],[data-wl],[data-review],[data-close],[data-copy],.swatch,.thumb,.tab,.q summary,.cat-card,.wish,.day{cursor:url({{ config('cursor-pointer-url') ?: 'data:image/png;base64,' }}) 3 0,pointer!important}
  input:not([type=button]):not([type=submit]):not([type=checkbox]):not([type=radio]),textarea{cursor:text!important}
  .busy,:disabled,[aria-disabled=true]{cursor:wait!important}
}
</style>
{% endif %}
