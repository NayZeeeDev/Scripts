{# ───────────────────────────────────────────────────────────
   NAYZEEE · module.holiday.twig
   Seasonal theme that switches automatically on the 1st of each month.
   Settings (scheme/EN.json): holiday-mode (Auto / Off / a theme key),
   holiday-recolor, holiday-particles, holiday-chip, holiday-density.
   Month → theme:
     1 newyear · 2 valentine · 3 stpatrick · 4 easter · 5 spring · 6 summer
     7 july4 · 8 summersale · 9 autumn · 10 halloween · 11 thanksgiving · 12 christmas
   ─────────────────────────────────────────────────────────── #}
{% set holMode = config('holiday-mode') ?: 'Auto' %}
{% if holMode != 'Off' %}
<style>
  /* each theme only overrides the accent tokens + the page glow; everything else stays NAYZEEE UI */
  html[data-hol-recolor="1"][data-holiday="newyear"]{--teal:#f5c451;--teal-hi:#ffd97a;--teal-lo:#b8902e;--teal-rgb:245,196,81;--on-teal:#201700;--hol-glow:#1a1707}
  html[data-hol-recolor="1"][data-holiday="valentine"]{--teal:#ff4d8d;--teal-hi:#ff7fae;--teal-lo:#c22a62;--teal-rgb:255,77,141;--on-teal:#2a0012;--hol-glow:#1c0c13}
  html[data-hol-recolor="1"][data-holiday="stpatrick"]{--teal:#2ecc71;--teal-hi:#5ee39a;--teal-lo:#1f8f4e;--teal-rgb:46,204,113;--on-teal:#002a12;--hol-glow:#0c1a10}
  html[data-hol-recolor="1"][data-holiday="easter"]{--teal:#b48cff;--teal-hi:#cbb0ff;--teal-lo:#7f5fd1;--teal-rgb:180,140,255;--on-teal:#14002e;--hol-glow:#141020}
  html[data-hol-recolor="1"][data-holiday="spring"]{--teal:#7ad15a;--teal-hi:#9fe683;--teal-lo:#4f9a38;--teal-rgb:122,209,90;--on-teal:#0f2600;--hol-glow:#101a0c}
  html[data-hol-recolor="1"][data-holiday="summer"]{--teal:#3fb6ff;--teal-hi:#7bcdff;--teal-lo:#1d7fbd;--teal-rgb:63,182,255;--on-teal:#001a2b;--hol-glow:#0b1620}
  html[data-hol-recolor="1"][data-holiday="july4"]{--teal:#ff5a5a;--teal-hi:#ff8a8a;--teal-lo:#c03030;--teal-rgb:255,90,90;--on-teal:#2b0000;--hol-glow:#1a0d12}
  html[data-hol-recolor="1"][data-holiday="summersale"]{--teal:#ffb020;--teal-hi:#ffc95c;--teal-lo:#c27f0a;--teal-rgb:255,176,32;--on-teal:#2a1a00;--hol-glow:#1c1608}
  html[data-hol-recolor="1"][data-holiday="autumn"]{--teal:#e0872b;--teal-hi:#f3a758;--teal-lo:#a85f17;--teal-rgb:224,135,43;--on-teal:#2a1400;--hol-glow:#1c1309}
  html[data-hol-recolor="1"][data-holiday="halloween"]{--teal:#ff7a1a;--teal-hi:#ffa04d;--teal-lo:#c25a0a;--teal-rgb:255,122,26;--on-teal:#2a1000;--hol-glow:#1a0f1c}
  html[data-hol-recolor="1"][data-holiday="thanksgiving"]{--teal:#d98c3a;--teal-hi:#f0ad5c;--teal-lo:#a2651f;--teal-rgb:217,140,58;--on-teal:#2a1600;--hol-glow:#1b140c}
  html[data-hol-recolor="1"][data-holiday="christmas"]{--teal:#22c55e;--teal-hi:#5ee08a;--teal-lo:#15803d;--teal-rgb:34,197,94;--on-teal:#00230c;--hol-glow:#0c1a12}
  html[data-holiday] body{background:radial-gradient(1100px 640px at 50% -8%,var(--hol-glow,#131718) 0%,transparent 62%),var(--void)}

  .hol-layer{position:fixed;inset:0;z-index:-1;pointer-events:none;overflow:hidden}
  .hol-p{position:absolute;top:-8vh;opacity:0;will-change:transform;color:var(--teal)}
  .hol-p svg{width:100%;height:100%;display:block;filter:drop-shadow(0 0 6px rgba(var(--teal-rgb),.35))}
  .hol-p.fall{animation:holFall var(--d,14s) linear var(--dl,0s) infinite}
  .hol-p.rise{top:auto;bottom:-8vh;animation:holRise var(--d,14s) linear var(--dl,0s) infinite}
  @keyframes holFall{0%{transform:translate3d(0,0,0) rotate(0deg);opacity:0}6%{opacity:var(--o,.45)}50%{transform:translate3d(var(--sx,30px),55vh,0) rotate(180deg)}94%{opacity:var(--o,.45)}100%{transform:translate3d(0,118vh,0) rotate(360deg);opacity:0}}
  @keyframes holRise{0%{transform:translate3d(0,0,0);opacity:0}6%{opacity:var(--o,.4)}50%{transform:translate3d(var(--sx,30px),-55vh,0)}94%{opacity:var(--o,.4)}100%{transform:translate3d(0,-118vh,0);opacity:0}}
  @media (prefers-reduced-motion:reduce){.hol-layer{display:none}}

  .hol-chip{display:inline-flex;align-items:center;gap:7px;height:26px;padding:0 10px 0 7px;border-radius:999px;background:var(--teal-wash);border:1px solid var(--teal-edge);font-size:10.5px;font-weight:500;color:var(--teal);white-space:nowrap;margin-left:4px}
  .hol-chip svg{width:14px;height:14px;display:block}
  @media (max-width:860px){.hol-chip span{display:none}.hol-chip{padding:0 7px}}
</style>
<div class="hol-layer" id="holLayer" aria-hidden="true"></div>
<script>
(function () {
  var MODE = {{ holMode|json_encode|raw }};
  var RECOLOR = {{ ((config('holiday-recolor') ?: 'On') != 'Off') ? 'true' : 'false' }};
  var PARTICLES = {{ ((config('holiday-particles') ?: 'On') != 'Off' and hol_quiet is not defined) ? 'true' : 'false' }};
  var CHIP = {{ ((config('holiday-chip') ?: 'Show') != 'Hide') ? 'true' : 'false' }};
  var DENSITY = parseInt({{ (config('holiday-density') ?: '28')|json_encode|raw }}, 10) || 28;
  var LABELS = {
    newyear: {{ (config('holiday-label-newyear') ?: 'New Year')|json_encode|raw }},
    valentine: {{ (config('holiday-label-valentine') ?: "Valentine's")|json_encode|raw }},
    stpatrick: {{ (config('holiday-label-stpatrick') ?: "St. Patrick's")|json_encode|raw }},
    easter: {{ (config('holiday-label-easter') ?: 'Easter')|json_encode|raw }},
    spring: {{ (config('holiday-label-spring') ?: 'Spring')|json_encode|raw }},
    summer: {{ (config('holiday-label-summer') ?: 'Summer')|json_encode|raw }},
    july4: {{ (config('holiday-label-july4') ?: '4th of July')|json_encode|raw }},
    summersale: {{ (config('holiday-label-summersale') ?: 'Summer sale')|json_encode|raw }},
    autumn: {{ (config('holiday-label-autumn') ?: 'Autumn')|json_encode|raw }},
    halloween: {{ (config('holiday-label-halloween') ?: 'Halloween')|json_encode|raw }},
    thanksgiving: {{ (config('holiday-label-thanksgiving') ?: 'Thanksgiving')|json_encode|raw }},
    christmas: {{ (config('holiday-label-christmas') ?: 'Christmas')|json_encode|raw }}
  };
  var BY_MONTH = ['newyear', 'valentine', 'stpatrick', 'easter', 'spring', 'summer', 'july4', 'summersale', 'autumn', 'halloween', 'thanksgiving', 'christmas'];
  /* glyphs: [svg path markup, motion, size px, extra glyph] */
  var G = {
    star: '<svg viewBox="0 0 24 24" fill="currentColor"><path d="M12 2.8l2.8 6 6.5.7-4.9 4.4 1.4 6.4L12 17l-5.8 3.3 1.4-6.4L2.7 9.5l6.5-.7z"/></svg>',
    sparkle: '<svg viewBox="0 0 24 24" fill="currentColor"><path d="M12 2l2.2 7.8L22 12l-7.8 2.2L12 22l-2.2-7.8L2 12l7.8-2.2z"/></svg>',
    heart: '<svg viewBox="0 0 24 24" fill="currentColor"><path d="M12 20.5l-7.2-7.3A4.6 4.6 0 0 1 11.3 6.7L12 7.4l.7-.7a4.6 4.6 0 0 1 6.5 6.5z"/></svg>',
    clover: '<svg viewBox="0 0 24 24" fill="currentColor"><circle cx="8" cy="8" r="4"/><circle cx="16" cy="8" r="4"/><circle cx="8" cy="16" r="4"/><circle cx="16" cy="16" r="4"/><path d="M12 12l2 9h-4z"/></svg>',
    egg: '<svg viewBox="0 0 24 24" fill="currentColor"><path d="M12 2c4 0 7 6 7 11a7 7 0 0 1-14 0C5 8 8 2 12 2z"/><path d="M6.5 13h11" stroke="#000" stroke-opacity=".25" stroke-width="1.5"/></svg>',
    flower: '<svg viewBox="0 0 24 24" fill="currentColor"><circle cx="12" cy="6" r="3.2"/><circle cx="12" cy="18" r="3.2"/><circle cx="6" cy="12" r="3.2"/><circle cx="18" cy="12" r="3.2"/><circle cx="12" cy="12" r="2.4" fill="#000" fill-opacity=".35"/></svg>',
    bubble: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="12" cy="12" r="9"/><path d="M8 9a4 4 0 0 1 3-3" stroke-linecap="round"/></svg>',
    sun: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><circle cx="12" cy="12" r="4"/><path d="M12 2v3M12 19v3M2 12h3M19 12h3M4.9 4.9l2.1 2.1M17 17l2.1 2.1M4.9 19.1L7 17M17 7l2.1-2.1"/></svg>',
    leaf: '<svg viewBox="0 0 24 24" fill="currentColor"><path d="M20 4c-9 0-15 5-16 14 2-1 4-1 6-1 7 0 10-7 10-13zM4 18c3-5 7-8 12-10" stroke="#000" stroke-opacity=".3" stroke-width="1.2" fill="none"/><path d="M20 4c-9 0-15 5-16 14 2-1 4-1 6-1 7 0 10-7 10-13z"/></svg>',
    bat: '<svg viewBox="0 0 24 24" fill="currentColor"><path d="M12 8c-1.5-2-4-3-7-2 1 2 .5 4-1 5 3 0 5 1 6 3l2-1 2 1c1-2 3-3 6-3-1.5-1-2-3-1-5-3-1-5.5 0-7 2z"/></svg>',
    pumpkin: '<svg viewBox="0 0 24 24" fill="currentColor"><path d="M12 5c-1 0-1.5-2-1-3 .5.5 1.5 1 1.5 2M7 7c-3 0-5 3-5 7s2 6 5 6c1 0 2-.5 2.5-1 1 .7 2 1 2.5 1s1.5-.3 2.5-1c.5.5 1.5 1 2.5 1 3 0 5-2 5-6s-2-7-5-7c-1 0-2 .3-2.5 1C14 7.3 13 7 12 7s-2 .3-2.5 1C9 7.3 8 7 7 7z"/><path d="M8 12l1.5 2h-3zM16 12l1.5 2h-3zM8 16.5c2.5 1.5 5.5 1.5 8 0l-1 2c-2 1-4 1-6 0z" fill="#000" fill-opacity=".45"/></svg>',
    snow: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"><path d="M12 2v20M2 12h20M5 5l14 14M19 5L5 19M12 2l-2 3M12 2l2 3M12 22l-2-3M12 22l2-3M2 12l3-2M2 12l3 2M22 12l-3-2M22 12l-3 2"/></svg>',
    gift: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M20 12v9H4v-9M2 7h20v5H2zM12 7v14M12 7s-1.5-4-4-4a2 2 0 0 0 0 4M12 7s1.5-4 4-4a2 2 0 0 1 0 4"/></svg>',
    turkey: '<svg viewBox="0 0 24 24" fill="currentColor"><path d="M12 4c-4 0-7 3-7 7 0 3 2 5 4 6v3h6v-3c2-1 4-3 4-6 0-4-3-7-7-7z"/><path d="M5 9L2 6M8 6L6 2M12 5l0-3M16 6l2-4M19 9l3-3" stroke="currentColor" stroke-width="2" stroke-linecap="round"/><circle cx="10" cy="10" r="1" fill="#000" fill-opacity=".5"/></svg>'
  };
  var THEMES = {
    newyear: { g: [G.sparkle, G.star], m: 'fall', s: [8, 16], chip: G.sparkle },
    valentine: { g: [G.heart], m: 'rise', s: [10, 20], chip: G.heart },
    stpatrick: { g: [G.clover], m: 'fall', s: [12, 22], chip: G.clover },
    easter: { g: [G.egg, G.flower], m: 'fall', s: [10, 18], chip: G.egg },
    spring: { g: [G.flower], m: 'fall', s: [10, 18], chip: G.flower },
    summer: { g: [G.bubble], m: 'rise', s: [8, 22], chip: G.sun },
    july4: { g: [G.star, G.sparkle], m: 'fall', s: [8, 16], chip: G.star },
    summersale: { g: [G.sun, G.sparkle], m: 'rise', s: [10, 20], chip: G.sun },
    autumn: { g: [G.leaf], m: 'fall', s: [12, 24], chip: G.leaf },
    halloween: { g: [G.bat, G.pumpkin, G.bat], m: 'fall', s: [14, 26], chip: G.pumpkin },
    thanksgiving: { g: [G.leaf, G.turkey, G.leaf, G.leaf], m: 'fall', s: [12, 24], chip: G.turkey },
    christmas: { g: [G.snow, G.snow, G.gift], m: 'fall', s: [8, 20], chip: G.gift }
  };
  var key = MODE === 'Auto' ? BY_MONTH[new Date().getMonth()] : (THEMES[MODE] ? MODE : null);
  if (!key) return;
  var root = document.documentElement;
  root.setAttribute('data-holiday', key);
  if (RECOLOR) root.setAttribute('data-hol-recolor', '1');
  var th = THEMES[key];

  if (CHIP) {
    var brand = document.querySelector('.nav .brand');
    if (brand) {
      var chip = document.createElement('span'); chip.className = 'hol-chip'; chip.title = LABELS[key];
      chip.innerHTML = th.chip + '<span>' + LABELS[key] + '</span>';
      brand.parentNode.insertBefore(chip, brand.nextSibling);
    }
  }
  if (PARTICLES && !(window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches)) {
    var layer = document.getElementById('holLayer');
    var n = Math.min(80, Math.max(0, DENSITY)), frag = document.createDocumentFragment();
    for (var i = 0; i < n; i++) {
      var p = document.createElement('span');
      var size = th.s[0] + Math.random() * (th.s[1] - th.s[0]);
      p.className = 'hol-p ' + th.m;
      p.style.left = (Math.random() * 100) + 'vw';
      p.style.width = p.style.height = size.toFixed(1) + 'px';
      p.style.setProperty('--d', (11 + Math.random() * 14).toFixed(1) + 's');
      p.style.setProperty('--dl', (-Math.random() * 25).toFixed(1) + 's');
      p.style.setProperty('--sx', ((Math.random() - .5) * 120).toFixed(0) + 'px');
      p.style.setProperty('--o', (0.18 + Math.random() * 0.32).toFixed(2));
      p.innerHTML = th.g[Math.floor(Math.random() * th.g.length)];
      frag.appendChild(p);
    }
    layer.appendChild(frag);
  }
  window.NZ_HOLIDAY = key;
})();
</script>
{% endif %}
