# Animations ship in the zip; poses you buy are often licensed one copy per
# server, so keep them out of public repos
stream/**/*.ycd

# Bag models are large; they ship in the zip
stream/**/*.ydr
stream/**/*.ytd
stream/**/*.ytyp

# Third-party props (bzzz) are regenerated with tools/rename_bzzz.py and shipped in the zip
stream/duffel/

# Python caches from the tools
__pycache__/
