<Project Sdk="Microsoft.NET.Sdk">

  <!--
    NayZeee Sneaker Studio. Needs CodeWalker.Core (https://github.com/dexyfex/CodeWalker):
    clone it next to this folder, or point CodeWalkerDir at your copy:
      dotnet build -p:CodeWalkerDir=C:\path\to\CodeWalker
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>NayZeee Sneaker Studio</AssemblyName>
    <RootNamespace>NayzeeeSneakerStudio</RootNamespace>
    <Version>1.0.0</Version>
    <InvariantGlobalization>true</InvariantGlobalization>
    <!-- smaller exe: only the .NET runtime is trimmed; this app and CodeWalker are kept whole -->
    <PublishTrimmed>true</PublishTrimmed>
    <TrimMode>partial</TrimMode>
    <SuppressTrimAnalysisWarnings>true</SuppressTrimAnalysisWarnings>
    <JsonSerializerIsReflectionEnabledByDefault>true</JsonSerializerIsReflectionEnabledByDefault>
    <NoWarn>$(NoWarn);CS8600;CS8602;CS8603;CS8604;CS8618;CS8625</NoWarn>
    <CodeWalkerDir Condition="'$(CodeWalkerDir)' == ''">$(MSBuildThisFileDirectory)../CodeWalker</CodeWalkerDir>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="$(CodeWalkerDir)/CodeWalker.Core/CodeWalker.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="web/**/*" LogicalName="web/%(RecursiveDir)%(Filename)%(Extension)" />
    <EmbeddedResource Include="../nayzeee-sneakers-boxes/stream/nzs_box/*.ydr;../nayzeee-sneakers-boxes/stream/nzs_box_heel/*.ydr;../nayzeee-sneakers-boxes/stream/nzs_box_boot/*.ydr" LogicalName="boxes/%(Filename)%(Extension)" />
  </ItemGroup>

</Project>
