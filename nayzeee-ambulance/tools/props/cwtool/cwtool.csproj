<Project Sdk="Microsoft.NET.Sdk">
  <!--
    cwtool - CodeWalker XML -> .ydr/.ytd/.ytyp converter + binary inspector (NAYZEEE props pipeline).

    CodeWalker (https://github.com/dexyfex/CodeWalker) is NOT vendored. Clone it anywhere and pass
    its folder:  dotnet build -c Release -p:CodeWalkerDir=/path/to/CodeWalker
    Default location: tools/props/CodeWalker (git-ignored). tools/props/build.py clones it into
    /tmp/nza-work/props/CodeWalker and passes the path for you.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <InvariantGlobalization>true</InvariantGlobalization>
    <RollForward>Major</RollForward>
    <NoWarn>$(NoWarn);CS0618;CS0168;CS0219;NU1701</NoWarn>
    <CodeWalkerDir Condition="'$(CodeWalkerDir)' == ''">$(MSBuildThisFileDirectory)../CodeWalker</CodeWalkerDir>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="$(CodeWalkerDir)/CodeWalker.Core/CodeWalker.Core.csproj" />
  </ItemGroup>
</Project>
